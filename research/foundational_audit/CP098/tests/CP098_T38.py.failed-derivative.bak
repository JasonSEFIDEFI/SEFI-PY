"""CP098-T38: Independent primary-constraint preservation.

Tests phi_T and phi_N under H_T=H_c+LT*phi_T+LN*phi_N.
External canonical pairs (u,p1), (q,P).
All canonical derivatives precede constraint substitution.
Internal brackets vanish because phi_T,phi_N contain no
internal coordinates or momenta.

No closure assumed.
"""
import sympy as sp

eta = sp.diag(-1, 1, 1, 1)
v, k = sp.symbols("v k", positive=True)
a, n, b, c, r, s, x, y = sp.symbols(
    "a n b c r s x y", real=True)
A, B, C = sp.symbols("A B C", nonzero=True, real=True)
DA, LT, LN = sp.symbols("DA LT LN", real=True)
e = sp.symbols("e", real=True)

def dot(X, Y):
    return (X.T*eta*Y)[0]

def pair(p, X):
    return (p.T*X)[0]

def geom(u, q):
    speed = sp.sqrt(-dot(u, u))
    T = u/speed
    tq = dot(T, q)
    w = q + T*tq
    w2 = dot(w, w)
    kap = sp.sqrt(w2)/speed**2
    N = w/sp.sqrt(w2)
    return speed, T, N, kap, w2

def phiT(u, q, P):
    return pair(P, geom(u, q)[1])

def phiN(u, q, P):
    return pair(P, geom(u, q)[2])

def H(u, q, P, p1, p0):
    speed, T, N, kap, w2 = geom(u, q)
    return (pair(p0, u) + pair(p1, q)
            + speed*(B+A*kap**2)
            - speed*w2*dot(P,P)/(4*C))

def directional(expr):
    return sp.factor(sp.diff(expr,e).subs(e,0))

u = sp.Matrix([v,0,0,0])
q = sp.Matrix([a,v**2*k,0,0])
P = sp.Matrix([0,0,r,s])
p1 = sp.Matrix([0,-2*A*k/v,x,y])
R = r*r+s*s
p0 = sp.Matrix([
    A*k*k+v**4*k*k*R/(4*C)-B,n,b,c
])

speed,T,N,kap,w2 = geom(u,q)

print("=== CP098-T38 ===",flush=True)

assert sp.simplify(phiT(u,q,P)) == 0
assert sp.simplify(phiN(u,q,P)) == 0
assert sp.simplify(pair(p1,T)) == 0
assert sp.simplify(pair(p1,N)+2*A*kap/speed) == 0
assert sp.simplify(
    pair(p0,T)+B-A*kap**2
    -w2*dot(P,P)/(4*C)
) == 0
print("PASS: all five constraints",flush=True)

# For f=phi_T or phi_N:
# {f,H} = f_u.H_p1 + f_q.H_P - f_P.H_q.
# H_p1=q; H_P=-speed*w2*eta*P/(2C).
#
# For f,g both primary:
# {f,g} = f_q.g_P - f_P.g_q.
# No u,p1 term because neither depends on p1.

def bracket_H(f):
    f_u = directional(f(u+e*q,q,P))
    f_q = -speed*w2/(2*C)*directional(
        f(u,q+e*(eta*P),P))
    f_P = -directional(
        H(u,q+e*(eta*sp.Matrix([
            sp.diff(f(u,q,P), z) for z in P
        ])),P,p1,p0))
    return sp.factor(f_u+f_q+f_P)

def bracket_prim(f,g):
    gf = sp.Matrix([
        sp.diff(g(u,q,P),z) for z in P
    ])
    ff = sp.Matrix([
        sp.diff(f(u,q,P),z) for z in P
    ])
    return sp.factor(
        directional(f(u,q+e*gf,P))
        -directional(g(u,q+e*ff,P))
    )

print("Computing {phi_T,Hc}...",flush=True)
FT = bracket_H(phiT)
print("Computing {phi_N,Hc}...",flush=True)
FN = bracket_H(phiN)

print("Computing primary bracket matrix...",flush=True)
BTT = bracket_prim(phiT,phiT)
BTN = bracket_prim(phiT,phiN)
BNT = bracket_prim(phiN,phiT)
BNN = bracket_prim(phiN,phiN)

assert sp.simplify(BTT) == 0
assert sp.simplify(BNN) == 0
assert sp.simplify(BTN+BNT) == 0

print("{phi_T,Hc} =",FT,flush=True)
print("{phi_N,Hc} =",FN,flush=True)
print("{phi_T,phi_T} =",BTT,flush=True)
print("{phi_T,phi_N} =",BTN,flush=True)
print("{phi_N,phi_T} =",BNT,flush=True)
print("{phi_N,phi_N} =",BNN,flush=True)

eqT = sp.factor(FT+LT*BTT+LN*BTN)
eqN = sp.factor(FN+LT*BNT+LN*BNN)

print("dot(phi_T) =",eqT,flush=True)
print("dot(phi_N) =",eqN,flush=True)

# Normal multiplier established in T34.
FN_chi = (
    -n-6*A*a*k/v**2
    -v**3*k*(r*x+s*y)/(2*C)
    -v**2*k*a*R/(2*C)
    +2*k*DA
)
LN_normal = -v**3*FN_chi/(2*A)

print("Normal multiplier =",sp.factor(LN_normal),
      flush=True)

print("dot(phi_T) after lambda_N =",
      sp.factor(eqT.subs(LN,LN_normal)),
      flush=True)
print("dot(phi_N) after lambda_N =",
      sp.factor(eqN.subs(LN,LN_normal)),
      flush=True)

print("PRIMARY PRESERVATION EXPRESSIONS CALCULATED")
print("NO CLOSURE ASSERTION")
print("DYNAMICAL CONSISTENCY: OPEN")
